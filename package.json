{
  "name": "nibras-secondary-school-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --config firebase.local.json --project demo-nibras-rules --only firestore \"pnpm test\"",
    "crew:check": "node scripts/crew-assets.mjs"
  },
  "dependencies": {
    "firebase": "13.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "15.37.0",
    "vite": "8.3.8"
  }
}
