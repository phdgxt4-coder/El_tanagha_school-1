rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /profiles/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isActiveAdmin());
      allow list: if isActiveAdmin();
      allow create, update, delete: if false;
    }

    match /teacherApplications/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isActiveAdmin());
      allow list: if isActiveAdmin();
      allow create, update, delete: if false;
    }

    match /publicTeachers/{teacherId} {
      allow get, list: if resource.data.published == true;
      allow create, update, delete: if false;
    }

    match /admins/{adminId} {
      allow get, list: if isActiveAdmin();
      allow create, update, delete: if false;
    }

    // No other collection is accessible unless a later, reviewed phase adds explicit rules.
  }
}
