# Firebase Web configuration: public client identifiers for the project you own.
# Keep real account credentials, service-account files, and student data out of Git.
VITE_BASE_PATH=/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_FIREBASE_VAPID_KEY=
