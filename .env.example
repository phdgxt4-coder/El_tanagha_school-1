# Firebase Web configuration: public client identifiers for the project you own.
# Keep real account credentials, service-account files, and student data out of Git.
VITE_BASE_PATH=/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_FIREBASE_VAPID_KEY=
VITE_BACKEND_MODE=spark   # spark = الخطة المجانية بدون وظائف، blaze = وظائف الخادم
VITE_APPCHECK_SITE_KEY=   # اختياري: مفتاح reCAPTCHA v3 لـ App Check
